# Local dev for the DMS domain app.
#
# ─── THIS FILE IS A STOPGAP, NOT AUTHORED CONTENT ───────────────────────────
# Every other zone's .env.local.example is produced by _Kit\sync-kit.ps1, which
# lands the fresh template as `.example` only when a `.env.local` is ALREADY
# present. Dms had none when it was scaffolded, so the template was written
# straight to `.env.local` and the `.example` never came into being — the same
# line of code that protects a populated zone leaves an empty one without it.
#
# `.env.local` now exists, so the next sync WILL generate this file from the
# template. That version supersedes this one and is not a regression: do not
# defend this text against it.
#
# Values are intentionally blank. Fill them from the Shell's own configuration.

# REQUIRED. toAbsoluteUrl() and apiFetch() read this at runtime; without it
# every /media, /fonts and /api/* request resolves against the origin root and
# 404s (or worse, silently hits the Shell). For this zone it is the basePath
# declared in next.config.mjs and in the domains.json registry row.
NEXT_PUBLIC_BASE_PATH=

# Must be byte-identical to the Shell's, or this app cannot decrypt the session
# cookie the Shell issued. Copy it from the Shell's .env.local — do not invent
# one, and compare by hash rather than by printing it. The service manager's
# web gate refuses to launch the zone without parity.
NEXTAUTH_SECRET=

# Backend services. Same values the Shell uses.
#
# ⚠ WHAT THIS FILE CLAIMS, AND WHAT IT DOES NOT. These are the keys `.env.local`
# CARRIES, inherited from the template — NOT a statement of what DMS uses.
# Of the four below, DMS's own code reads exactly one: AUTH_API_BASE_URL, at
# services/auth-api.ts:9. COMMON_API_BASE_URL, PERSON_API_BASE_URL and
# COMPANY_API_BASE_URL appear in no source file in this repo.
#
# The distinction matters more here than it looks. Read as a dependency list,
# this file says DMS talks to three backend services — which contradicts the
# project's hardest boundary. DMS is frontend and mock data only: no database,
# no backend service, and all of its domain data comes from
# lib/dms/mock-store.ts. The zone is not network-free, because the template's
# auth chrome talks to the Auth service — but that is the template, not DMS.
#
# They are documented rather than pruned because this file records what
# `.env.local` holds, and the next sync would restore them regardless.
AUTH_API_BASE_URL=
COMMON_API_BASE_URL=
PERSON_API_BASE_URL=
COMPANY_API_BASE_URL=
